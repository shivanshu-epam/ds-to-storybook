{
  "name": "ds-sync",
  "version": "0.1.0",
  "description": "Generate and sync a tested Storybook from a Figma design system.",
  "keywords": [
    "figma",
    "storybook",
    "design-system",
    "design-tokens",
    "web-components",
    "react",
    "lit",
    "codegen",
    "accessibility",
    "visual-regression"
  ],
  "license": "MIT",
  "homepage": "https://github.com/shivanshu-epam/ds-to-storybook#readme",
  "bugs": {
    "url": "https://github.com/shivanshu-epam/ds-to-storybook/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivanshu-epam/ds-to-storybook.git",
    "directory": "engine"
  },
  "type": "module",
  "bin": {
    "ds-sync": "dist/cli.js"
  },
  "files": [
    "dist",
    "archetypes",
    "templates",
    "README.md",
    "LICENSE",
    "claude-plugin",
    "schemas"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepack": "npm run build",
    "ds-sync": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pngjs": "6.0.5",
    "tsx": "4.20.6",
    "vitest": "3.2.4"
  }
}
