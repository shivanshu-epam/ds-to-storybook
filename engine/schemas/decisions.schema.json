{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shivanshu-epam/ds-to-storybook/engine/schemas/decisions.schema.json",
  "title": "ds-sync.decisions.json",
  "description": "Interpretation decisions for a design system: code names and descriptions for Figma properties, with evidence, author and review status. The generator applies accepted entries.",
  "type": "object",
  "required": [
    "version",
    "sets"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "sets": {
      "type": "object",
      "description": "Keyed by Figma component set name.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "proposed",
              "accepted",
              "rejected"
            ]
          },
          "description": {
            "type": "string"
          },
          "by": {
            "type": "string",
            "description": "ai:<model>, or the reviewer."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "setHash": {
            "type": "string"
          },
          "props": {
            "type": "object",
            "description": "Keyed by Figma property name.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z0-9]*$"
                },
                "description": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "proposed",
                    "accepted",
                    "rejected"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "revision": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "A change an AI proposed after this property was accepted. The accepted fields stay in force until a person accepts it (ds-sync decisions accept).",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][A-Za-z0-9]*$"
                    },
                    "description": {
                      "type": "string"
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "role": {
                  "enum": [
                    "api",
                    "internal"
                  ],
                  "description": "internal: a Figma construction property, not part of the API (hidden from controls and the props table)."
                },
                "values": {
                  "type": "object",
                  "description": "Figma value -> code value, for a variant property.",
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][\\w.-]*$"
                  }
                },
                "components": {
                  "type": "object",
                  "description": "Figma value -> component name: values that are their own component in code (Skeleton -> ButtonSkeleton).",
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Za-z0-9]*$"
                  }
                }
              }
            }
          },
          "archetype": {
            "enum": [
              "generic",
              "button",
              "link",
              "checkbox",
              "switch",
              "disclosure",
              "combobox"
            ],
            "description": "Behaviour template for this set, when structure and names cannot tell."
          },
          "usage": {
            "type": "object",
            "required": [
              "status",
              "sources"
            ],
            "additionalProperties": false,
            "description": "Usage guidance with its own review status; every sentence cites ids in sources.",
            "properties": {
              "status": {
                "enum": [
                  "proposed",
                  "accepted",
                  "rejected"
                ]
              },
              "by": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "setHash": {
                "type": "string"
              },
              "whenToUse": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "text",
                    "sources"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sources": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "whenNotToUse": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "text",
                    "sources"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sources": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "variants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "property",
                    "value",
                    "text",
                    "sources"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "property": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sources": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "content": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "text",
                    "sources"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sources": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "sources": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "kind",
                    "text"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  }
                }
              },
              "questions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
