{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shivanshu-epam/ds-to-storybook/engine/schemas/decisions.schema.json",
  "title": "ds-sync.decisions.json",
  "description": "Interpretation decisions for a design system: code names and descriptions for Figma properties, with evidence, author and review status. The generator applies accepted entries.",
  "type": "object",
  "required": [
    "version",
    "sets"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "sets": {
      "type": "object",
      "description": "Keyed by Figma component set name.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "proposed",
              "accepted",
              "rejected"
            ]
          },
          "description": {
            "type": "string"
          },
          "by": {
            "type": "string",
            "description": "ai:<model>, or the reviewer."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "setHash": {
            "type": "string"
          },
          "props": {
            "type": "object",
            "description": "Keyed by Figma property name.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z0-9]*$"
                },
                "description": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "proposed",
                    "accepted",
                    "rejected"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "archetype": {
            "enum": [
              "generic",
              "button",
              "link",
              "checkbox",
              "switch",
              "disclosure"
            ],
            "description": "Behaviour template for this set, when structure and names cannot tell."
          }
        }
      }
    }
  }
}
